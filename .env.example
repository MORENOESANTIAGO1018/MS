# Copie para .env.local (desenvolvimento) e NUNCA faça commit do arquivo preenchido.
# Ver VARIAVEIS-DE-AMBIENTE.md para descricao detalhada de cada variavel.
# Valores abaixo sao exemplos ILUSTRATIVOS e NAO FUNCIONAIS.

# ---------------------------------------------------------------------------
# Supabase (obrigatorio)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey.your-anon-key
# Critico: nunca expor ao navegador. Usada apenas em app/api/** e lib/server/*.
SUPABASE_SERVICE_ROLE_KEY=ey.your-service-role-key
# Connection string direta, usada por scripts de migration/CI e testes SQL.
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Notion (server-only)
# ---------------------------------------------------------------------------
NOTION_TOKEN=ntn_your_internal_integration_token
NOTION_ROOT_PAGE_ID=00000000000000000000000000000000
NOTION_DB_CLIENTES_ID=00000000000000000000000000000000
NOTION_DB_PROCESSOS_ID=00000000000000000000000000000000
NOTION_DB_ANDAMENTOS_ID=00000000000000000000000000000000
NOTION_DB_AUDIENCIAS_ID=00000000000000000000000000000000
NOTION_DB_CONTRATOS_ID=00000000000000000000000000000000
NOTION_DB_FINANCEIRO_ID=00000000000000000000000000000000
NOTION_DB_DOCUMENTOS_ID=00000000000000000000000000000000
NOTION_DB_USUARIOS_PORTAL_ID=00000000000000000000000000000000

# ---------------------------------------------------------------------------
# Claude / Anthropic (server-only)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# n8n / automacao
# ---------------------------------------------------------------------------
N8N_WEBHOOK_SECRET=change-me-shared-hmac-secret
N8N_BASE_URL=https://n8n.your-domain.com
N8N_TRIGGER_TOKEN=change-me-token-para-o-portal-chamar-o-n8n

# ---------------------------------------------------------------------------
# Autenticacao e sessao
# ---------------------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MIN=30
ACTIVATION_CODE_TTL_HOURS=72
ACTIVATION_CODE_PEPPER=change-me-server-side-pepper
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MIN=15

# ---------------------------------------------------------------------------
# Aplicacao / institucional
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OFFICE_NAME=Moreno & Santiago Advogados
NEXT_PUBLIC_OFFICE_PHONE=+55 11 0000-0000
NEXT_PUBLIC_OFFICE_WHATSAPP=+55 11 90000-0000
NEXT_PUBLIC_OFFICE_EMAIL=contato@morenoesantiago.com
NEXT_PUBLIC_OFFICE_ADDRESS=Endereco do escritorio, Sao Paulo/SP
NEXT_PUBLIC_OFFICE_HOURS=Seg a Sex, 9h as 18h

AUDIT_LOG_RETENTION_DAYS=180
NODE_ENV=development

# ---------------------------------------------------------------------------
# Documentos (Fase 9)
# ---------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_MB=20
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/png,image/jpeg,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
DOCUMENT_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Publicacao / operacao (Fase 15)
# ---------------------------------------------------------------------------
# "true" redireciona todo trafego para /manutencao (exceto a propria pagina).
# Deixe ausente/"false" em operacao normal.
MAINTENANCE_MODE=false
