{
  "name": "03 - Reenvio de codigo de ativacao (e-mail)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "codigo-reenviado",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: codigo-reenviado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "codigo-reenviado"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{$json.headers['x-portal-token']}}",
              "rightValue": "={{$env.N8N_TRIGGER_TOKEN}}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "name": "Token do portal valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$json.body.email}}",
        "subject": "Novo código de ativação — Portal do Cliente",
        "emailFormat": "text",
        "text": "=Olá {{$json.body.fullName}},\n\nUm novo código de ativação de uso único foi gerado para o seu acesso:\n\n{{$json.body.code}}\n\nO código anterior deixou de ser válido. Este expira em algumas horas e só pode ser usado uma vez.\n\nMoreno & Santiago Advogados"
      },
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 220],
      "credentials": { "smtp": { "id": "SMTP_CREDENCIAL_ID", "name": "SMTP escritorio" } }
    },
    {
      "parameters": {},
      "name": "Descartar (token invalido)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 400]
    }
  ],
  "connections": {
    "Webhook: codigo-reenviado": {
      "main": [[{ "node": "Token do portal valido?", "type": "main", "index": 0 }]]
    },
    "Token do portal valido?": {
      "main": [
        [{ "node": "Enviar e-mail", "type": "main", "index": 0 }],
        [{ "node": "Descartar (token invalido)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
