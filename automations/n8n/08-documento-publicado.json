{
  "name": "08 - Documento publicado (e-mail ao cliente)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "documento-publicado",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: documento-publicado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "documento-publicado"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{$json.headers['x-portal-token']}}",
              "rightValue": "={{$env.N8N_TRIGGER_TOKEN}}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{$json.body.clientEmail}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Token valido e cliente tem e-mail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$json.body.clientEmail}}",
        "subject": "Novo documento disponível — Moreno & Santiago Advogados",
        "emailFormat": "text",
        "text": "=Olá {{$json.body.clientName}},\n\nUm novo documento (\"{{$json.body.name}}\") foi disponibilizado para você no Portal do Cliente. Acesse o portal para baixá-lo com segurança.\n\nMoreno & Santiago Advogados"
      },
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 220],
      "credentials": { "smtp": { "id": "SMTP_CREDENCIAL_ID", "name": "SMTP escritorio" } }
    },
    {
      "parameters": {},
      "name": "Descartar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 400]
    }
  ],
  "connections": {
    "Webhook: documento-publicado": {
      "main": [[{ "node": "Token valido e cliente tem e-mail?", "type": "main", "index": 0 }]]
    },
    "Token valido e cliente tem e-mail?": {
      "main": [
        [{ "node": "Enviar e-mail", "type": "main", "index": 0 }],
        [{ "node": "Descartar", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
