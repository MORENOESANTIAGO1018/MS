{
  "name": "02 - Criacao de convite (e-mail com codigo de ativacao)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "convite-criado",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: convite-criado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "convite-criado"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{$json.headers['x-portal-token']}}",
              "rightValue": "={{$env.N8N_TRIGGER_TOKEN}}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "name": "Token do portal valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$json.body.email}}",
        "subject": "Seu acesso ao Portal do Cliente — Moreno & Santiago Advogados",
        "emailFormat": "text",
        "text": "=Olá {{$json.body.fullName}},\n\nSeu código de ativação de uso único para acessar o Portal do Cliente é:\n\n{{$json.body.code}}\n\nAcesse o portal, informe seu e-mail e este código para criar sua senha. O código expira em algumas horas e só pode ser usado uma vez — se não foi você quem solicitou, ignore esta mensagem.\n\nMoreno & Santiago Advogados"
      },
      "name": "Enviar e-mail de convite",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 220],
      "credentials": { "smtp": { "id": "SMTP_CREDENCIAL_ID", "name": "SMTP escritorio" } }
    },
    {
      "parameters": {},
      "name": "Descartar (token invalido)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 400]
    }
  ],
  "connections": {
    "Webhook: convite-criado": {
      "main": [[{ "node": "Token do portal valido?", "type": "main", "index": 0 }]]
    },
    "Token do portal valido?": {
      "main": [
        [{ "node": "Enviar e-mail de convite", "type": "main", "index": 0 }],
        [{ "node": "Descartar (token invalido)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
