{
  "name": "10 - Nova mensagem no portal",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nova-mensagem",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: nova-mensagem",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "nova-mensagem"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{$json.headers['x-portal-token']}}",
              "rightValue": "={{$env.N8N_TRIGGER_TOKEN}}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{$json.body.recipientEmail}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Token valido e tem destinatario?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$json.body.recipientEmail}}",
        "subject": "Nova mensagem no Portal do Cliente",
        "emailFormat": "text",
        "text": "=Você recebeu uma nova mensagem no canal do Portal do Cliente. Acesse o portal para ler e responder.\n\nMoreno & Santiago Advogados"
      },
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 220],
      "credentials": { "smtp": { "id": "SMTP_CREDENCIAL_ID", "name": "SMTP escritorio" } }
    },
    {
      "parameters": {},
      "name": "Descartar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 400]
    }
  ],
  "connections": {
    "Webhook: nova-mensagem": {
      "main": [[{ "node": "Token valido e tem destinatario?", "type": "main", "index": 0 }]]
    },
    "Token valido e tem destinatario?": {
      "main": [
        [{ "node": "Enviar e-mail", "type": "main", "index": 0 }],
        [{ "node": "Descartar", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
